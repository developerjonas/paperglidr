{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "DB_HOST",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_PORT",
        "DB_SSL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "AUTH_COOKIE_DOMAIN",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_LANDING_URL",
        "NEXT_PUBLIC_IMAGE_HOSTS",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "BUNNY_STREAM_LIBRARY_ID",
        "BUNNY_STREAM_TOKEN_AUTH_KEY",
        "RESEND_API_KEY",
        "INVOICE_FROM_EMAIL",
        "NOTIFICATIONS_FROM_EMAIL",
        "SMSPASAL_API_KEY",
        "SMSPASAL_SENDER_ID",
        "SMSPASAL_CAMPAIGN_ID",
        "SMSPASAL_ROUTE_ID",
        "PAYMENT_MODE",
        "PAYMENT_ENABLED_GATEWAYS",
        "ESEWA_PRODUCT_CODE",
        "ESEWA_SECRET_KEY",
        "ESEWA_FORM_URL",
        "ESEWA_STATUS_URL",
        "KHALTI_SECRET_KEY",
        "KHALTI_BASE_URL",
        "FONEPAY_MERCHANT_CODE",
        "FONEPAY_SECRET_KEY",
        "FONEPAY_USERNAME",
        "FONEPAY_PASSWORD",
        "FONEPAY_BASE_URL",
        "CRON_SECRET"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
