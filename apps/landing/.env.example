# PaperGlidr landing site (apps/landing) — copy to .env.local for local dev.
# Every page is statically prerendered, so these are baked in at build time.
# Also listed in turbo.json `build.env` (strict env mode).

# [required] Public URL of the web app, no trailing slash — used for "Browse courses" / "Start teaching" links
NEXT_PUBLIC_APP_URL=http://localhost:3000
