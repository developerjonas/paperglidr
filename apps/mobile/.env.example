# Copy to .env.local (git-ignored). Optional: where the app finds the web app's /api/v1 — no trailing slash.
# Unset in development: the app uses http://<your computer's LAN IP>:3000,
# i.e. `pnpm dev` in apps/web on the machine running Expo.
# Unset in release builds: https://chiyali.com.
# EXPO_PUBLIC_API_URL=https://staging.chiyali.com
