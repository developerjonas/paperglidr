# PaperGlidr web app (apps/web) — copy to .env.local for local dev.
# In Vercel, set these per environment (Production / Preview / Development).
# Every variable is also listed in turbo.json `build.env`; turbo runs in
# strict env mode, so a variable missing there is invisible to `pnpm build`.
#
# [required] = app refuses to start/build without it (t3-env validation)
# [optional] = feature degrades gracefully when unset
# Set SKIP_ENV_VALIDATION=1 to build without any of these (CI/type checks only).

# ---------------------------------------------------------------- Database
# [required] Postgres host, e.g. localhost or your managed DB hostname
DB_HOST=localhost
# [optional] Postgres port, defaults to 5432
DB_PORT=5432
# [required] Postgres user
DB_USER=postgres
# [required] Postgres password
DB_PASSWORD=
# [required] Database name
DB_NAME=paperglidr
# [optional] "false" for local Postgres without TLS; defaults to "true" (keep true in production)
DB_SSL=false

# ---------------------------------------------------------------- Auth (Better Auth)
# [required] Random secret, at least 32 chars — e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# [required] Server-side base URL of this app, e.g. https://app.paperglidr.com
BETTER_AUTH_URL=http://localhost:3000
# [required] Google OAuth client (Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
# [required] Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# [optional] GitHub OAuth app — GitHub sign-in is only enabled when both are set
GITHUB_CLIENT_ID=
# [optional] GitHub OAuth app secret
GITHUB_CLIENT_SECRET=
# [optional] Extra origins allowed to call the auth API, comma-separated (BETTER_AUTH_URL's origin is always trusted)
# Production: https://paperglidr.com,https://www.paperglidr.com,paperglidr://   (paperglidr:// = mobile app deep links)
BETTER_AUTH_TRUSTED_ORIGINS=
# [optional] Parent domain to share the session cookie across subdomains, e.g. .paperglidr.com. Unset = host-only cookie (use unset for localhost/preview deploys)
AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------- Public URLs (inlined into the browser bundle)
# [required] Public URL of this app, no trailing slash — used for payment return URLs, certificate QR codes, email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [required] URL the browser uses for Better Auth — normally the same as NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# [required] Landing/legal site, used by footer links, e.g. https://paperglidr.com
NEXT_PUBLIC_LANDING_URL=http://localhost:3001

# ---------------------------------------------------------------- Storage (Cloudflare R2)
# [required] Cloudflare account ID (endpoint is https://<id>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=
# [required] R2 API token access key ID
R2_ACCESS_KEY_ID=
# [required] R2 API token secret
R2_SECRET_ACCESS_KEY=
# [required] Private bucket for lesson files and invoice PDFs
R2_BUCKET_NAME=

# ---------------------------------------------------------------- Video (Bunny Stream — not used at launch)
# [optional] Bunny Stream library ID
BUNNY_STREAM_LIBRARY_ID=
# [optional] Library → Security → Token Authentication Key (NOT the API key)
BUNNY_STREAM_TOKEN_AUTH_KEY=

# ---------------------------------------------------------------- Email (Resend)
# [required] Resend API key
RESEND_API_KEY=
# [required] Sender for invoices, e.g. "PaperGlidr <billing@paperglidr.com>" (domain verified in Resend)
INVOICE_FROM_EMAIL=
# [required] Sender for Q&A reply notifications, e.g. "PaperGlidr <notifications@paperglidr.com>"
NOTIFICATIONS_FROM_EMAIL=

# ---------------------------------------------------------------- SMS (SMSPasal — instructor phone verification)
# [optional] SMSPasal API key — without it, phone verification returns "SMS gateway not configured"
SMSPASAL_API_KEY=
# [optional] Approved sender ID
SMSPASAL_SENDER_ID=
# [optional] Campaign ID
SMSPASAL_CAMPAIGN_ID=
# [optional] Route ID
SMSPASAL_ROUTE_ID=

# ---------------------------------------------------------------- Payments
# Read directly by services/payments/* today (not yet validated — a dedicated
# payments config with PAYMENT_MODE=sandbox|live is GTM plan task 7).
# WARNING: until task 7 lands, a missing URL/product code silently falls back
# to the gateway's SANDBOX endpoint. Set all of them explicitly in production.

# eSewa ePay v2
# [required for eSewa] Merchant product code (sandbox: EPAYTEST)
ESEWA_PRODUCT_CODE=
# [required for eSewa] HMAC secret key from eSewa
ESEWA_SECRET_KEY=
# [required for eSewa in production] Form URL (sandbox: https://rc-epay.esewa.com.np/api/epay/main/v2/form)
ESEWA_FORM_URL=
# [required for eSewa in production] Status API (sandbox: https://rc.esewa.com.np/api/epay/transaction/status/)
ESEWA_STATUS_URL=

# Khalti KPG-2
# [required for Khalti] Secret key from the Khalti merchant dashboard (test key in sandbox)
KHALTI_SECRET_KEY=
# [required for Khalti in production] Initiate URL (sandbox: https://dev.khalti.com/api/v2/epayment/initiate/)
KHALTI_INITIATE_URL=
# [required for Khalti in production] Lookup URL (sandbox: https://dev.khalti.com/api/v2/epayment/lookup/)
KHALTI_LOOKUP_URL=

# Fonepay dynamic QR
# [required for Fonepay] Merchant code from Fonepay / acquiring bank
FONEPAY_MERCHANT_CODE=
# [required for Fonepay] HMAC-SHA512 secret key
FONEPAY_SECRET_KEY=
# [required for Fonepay] API username
FONEPAY_USERNAME=
# [required for Fonepay] API password
FONEPAY_PASSWORD=
# [required for Fonepay in production] Base URL (sandbox: https://dev-clientapi.fonepay.com/api/merchant/merchantDetailsForThirdParty)
FONEPAY_DYNAMIC_QR_URL=


# ---------------------------------------------------------------- Scripts only (not read by the app)
# [optional] Used by `pnpm db:seed` — this existing user (signed in once via Google) is promoted to admin
ADMIN_EMAIL=
