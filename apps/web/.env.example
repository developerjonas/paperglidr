# PaperGlidr web app (apps/web) — copy to .env.local for local dev.
# In Vercel, set these per environment (Production / Preview / Development).
# Every variable is also listed in turbo.json `build.env`; turbo runs in
# strict env mode, so a variable missing there is invisible to `pnpm build`.
#
# [required] = app refuses to start/build without it (t3-env validation)
# [optional] = feature degrades gracefully when unset
# Set SKIP_ENV_VALIDATION=1 to build without any of these (CI/type checks only).

# ---------------------------------------------------------------- Database
# [required] Postgres host, e.g. localhost or your managed DB hostname
DB_HOST=localhost
# [optional] Postgres port, defaults to 5432
DB_PORT=5432
# [required] Postgres user
DB_USER=postgres
# [required] Postgres password
DB_PASSWORD=
# [required] Database name
DB_NAME=paperglidr
# [optional] "false" for local Postgres without TLS; defaults to "true" (keep true in production)
DB_SSL=false

# ---------------------------------------------------------------- Auth (Better Auth)
# [required] Random secret, at least 32 chars — e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# [required] Server-side base URL of this app. Production: https://paperglidr.com (the one canonical domain)
BETTER_AUTH_URL=http://localhost:3000
# [required] Google OAuth client (Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
# [required] Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# [optional] GitHub OAuth app — GitHub sign-in is only enabled when both are set
GITHUB_CLIENT_ID=
# [optional] GitHub OAuth app secret
GITHUB_CLIENT_SECRET=
# [optional] Extra origins allowed to call the auth API, comma-separated (BETTER_AUTH_URL's origin — https://paperglidr.com — is always trusted)
# Production: https://www.paperglidr.com,paperglidr://   (paperglidr:// = mobile app deep links). app.paperglidr.com redirects to
# paperglidr.com, so it never calls the auth API and must not be listed.
BETTER_AUTH_TRUSTED_ORIGINS=
# [optional] Parent domain to share the session cookie across subdomains. NOT needed: the whole site is served from
# paperglidr.com, so leave this UNSET in production (host-only cookie). Only set it if the app is ever split across subdomains again.
AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------- Public URLs (inlined into the browser bundle)
# [required] Canonical public URL, no trailing slash. Production: https://paperglidr.com — used for payment return URLs,
# certificate QR codes, email links, canonical/Open Graph URLs and the sitemap
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [required] URL the browser uses for Better Auth — the same as NEXT_PUBLIC_APP_URL (production: https://paperglidr.com)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# [optional, needed for course images] Extra hosts next/image may load from, comma-separated hostnames (no scheme).
# Product and instructor image URLs must be https on one of these hosts (Google/GitHub avatars are built in).
# There is no image upload yet — list wherever creators' images are hosted, e.g. images.paperglidr.com,res.cloudinary.com
NEXT_PUBLIC_IMAGE_HOSTS=

# ---------------------------------------------------------------- Storage (Cloudflare R2)
# [required] Cloudflare account ID (endpoint is https://<id>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=
# [required] R2 API token access key ID
R2_ACCESS_KEY_ID=
# [required] R2 API token secret
R2_SECRET_ACCESS_KEY=
# [required] Private bucket for lesson files and invoice PDFs
R2_BUCKET_NAME=

# ---------------------------------------------------------------- Video (Bunny Stream — not used at launch)
# [optional] Bunny Stream library ID
BUNNY_STREAM_LIBRARY_ID=
# [optional] Library → Security → Token Authentication Key (NOT the API key)
BUNNY_STREAM_TOKEN_AUTH_KEY=

# ---------------------------------------------------------------- Email (Resend)
# [required] Resend API key
RESEND_API_KEY=
# [required] Sender for invoices, e.g. "PaperGlidr <billing@paperglidr.com>" (domain verified in Resend)
INVOICE_FROM_EMAIL=
# [required] Sender for Q&A reply notifications, e.g. "PaperGlidr <notifications@paperglidr.com>"
NOTIFICATIONS_FROM_EMAIL=

# ---------------------------------------------------------------- SMS (SMSPasal — instructor phone verification)
# [optional] SMSPasal API key — without it, phone verification returns "SMS gateway not configured"
SMSPASAL_API_KEY=
# [optional] Approved sender ID
SMSPASAL_SENDER_ID=
# [optional] Campaign ID
SMSPASAL_CAMPAIGN_ID=
# [optional] Route ID
SMSPASAL_ROUTE_ID=

# ---------------------------------------------------------------- Payments
# Resolved by src/services/payments/config.ts (see docs/GTM_PLAN.md Part 2).
#   sandbox: env values override the built-in SANDBOX_DEFAULTS (eSewa's public
#            EPAYTEST merchant works with nothing set here).
#   live:    env values only — a gateway with any missing value is DISABLED
#            and hidden at checkout; it never falls back to sandbox. A sandbox
#            URL or test credential in live mode stops the server at boot.

# [required] "sandbox" or "live". Use sandbox everywhere except Vercel Production.
PAYMENT_MODE=sandbox
# [optional] Kill switch / allow-list, e.g. "esewa,khalti". Unset = every configured gateway.
PAYMENT_ENABLED_GATEWAYS=

# eSewa ePay v2 — sandbox defaults: EPAYTEST + rc-epay/rc URLs (no need to set these in sandbox)
# [required for eSewa in live] Merchant product code from eSewa
ESEWA_PRODUCT_CODE=
# [required for eSewa in live] HMAC secret key from eSewa
ESEWA_SECRET_KEY=
# [required for eSewa in live] e.g. https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_FORM_URL=
# [required for eSewa in live] e.g. https://epay.esewa.com.np/api/epay/transaction/status/
ESEWA_STATUS_URL=

# Khalti KPG-2 — no shared test key exists: in sandbox too, Khalti is enabled only when KHALTI_SECRET_KEY is set
# [required for Khalti] Secret key (test key from the Khalti sandbox merchant dashboard in sandbox)
KHALTI_SECRET_KEY=
# [required for Khalti in live] API base, e.g. https://khalti.com/api/v2 (sandbox default: https://dev.khalti.com/api/v2)
KHALTI_BASE_URL=

# Fonepay dynamic QR — credentials come from Fonepay / the acquiring bank; disabled until all are set
# [required for Fonepay] Merchant code
FONEPAY_MERCHANT_CODE=
# [required for Fonepay] HMAC-SHA512 secret key
FONEPAY_SECRET_KEY=
# [required for Fonepay] API username
FONEPAY_USERNAME=
# [required for Fonepay] API password
FONEPAY_PASSWORD=
# [required for Fonepay in live] API base URL from Fonepay (sandbox default: the dev-clientapi URL)
FONEPAY_BASE_URL=

# ---------------------------------------------------------------- Cron
# [required in production] Secret for GET/POST /api/cron/reconcile-payments, sent as "Authorization: Bearer <secret>".
# At least 32 chars, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically when set.
# Unset = the endpoint refuses every request (pending payments are then only settled by return routes / admin re-check).
CRON_SECRET=

# ---------------------------------------------------------------- Scripts only (not read by the app)
# [optional] Used by `pnpm db:seed` — this existing user (signed in once via Google) is promoted to admin
ADMIN_EMAIL=
